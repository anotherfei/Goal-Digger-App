{
  "name": "goal-digger-functions",
  "description": "Goal Digger – Firebase Functions backend (Genkit + Gemini)",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test lib/notifications/notificationTriage.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.35.0",
    "@genkit-ai/google-genai": "^1.35.0",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^6.0.0",
    "genkit": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
