rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function validOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function validNotificationType(type) {
      return type in [
        'dailyPlan',
        'taskReminder',
        'streakSaver',
        'deadlineWarning',
        'routineReminder',
        'focusComplete',
        'moodNudge',
        'reward',
        'community',
        'friend',
        'chat',
        'important'
      ];
    }

    function validNotificationDelivery(delivery) {
      return delivery in ['system', 'inApp'];
    }

    function validNotification(data, notificationId) {
      return data.keys().hasOnly([
          'id',
          'title',
          'body',
          'type',
          'delivery',
          'createdAt',
          'readAt',
          'important',
          'sourceId',
          'payload',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'title',
          'body',
          'type',
          'delivery',
          'createdAt',
          'important'
        ])
        && validString(data.id, 140)
        && data.id == notificationId
        && validString(data.title, 120)
        && data.body is string
        && data.body.size() <= 500
        && validNotificationType(data.type)
        && validNotificationDelivery(data.delivery)
        && data.createdAt is timestamp
        && validOptionalString(data.sourceId, 140)
        && (data.readAt == null || data.readAt is timestamp)
        && data.important is bool
        && (data.payload == null ||
          (data.payload is map && data.payload.keys().size() <= 10))
        && (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function validSocialNotificationCreate(uid, notificationId) {
      return isSignedIn()
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly([
          'id',
          'title',
          'body',
          'type',
          'delivery',
          'createdAt',
          'readAt',
          'important',
          'sourceId',
          'payload',
          'actorUid',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'title',
          'body',
          'type',
          'delivery',
          'createdAt',
          'important',
          'payload',
          'actorUid'
        ])
        && request.resource.data.id == notificationId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type in ['community', 'friend', 'chat']
        && request.resource.data.delivery == 'inApp'
        && request.resource.data.important == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.readAt == null || request.resource.data.readAt is timestamp)
        && validOptionalString(request.resource.data.sourceId, 140)
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().size() <= 10
        && request.resource.data.payload.actorUid == request.auth.uid
        && (request.resource.data.updatedAt == null || request.resource.data.updatedAt is timestamp);
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function validDirectChatCreate() {
      return isSignedIn()
        && request.resource.data.type == 'direct'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
    }

    function validDirectMessageCreate(chatId) {
      return isChatMember(chatId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
    }

    function isCommunityParticipant(communityId) {
      return isSignedIn()
        && (
          get(/databases/$(database)/documents/communities/$(communityId)).data.creatorUid == request.auth.uid ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid ||
          (
            get(/databases/$(database)/documents/communities/$(communityId)).data.members is list &&
            request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members
          )
        );
    }

    function validCommunityDailyActivity(data, activityDateKey, communityId) {
      return data.keys().hasOnly([
          'dateKey',
          'activeMemberUids',
          'activeMemberCount',
          'requiredActiveMembers',
          'qualified',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'dateKey',
          'activeMemberUids',
          'activeMemberCount',
          'requiredActiveMembers',
          'qualified',
          'updatedAt'
        ])
        && data.dateKey == activityDateKey
        && data.dateKey is string
        && data.dateKey.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && data.activeMemberUids is list
        && data.activeMemberUids.size() > 0
        && data.activeMemberUids.size() <= 500
        && get(/databases/$(database)/documents/communities/$(communityId)).data.members is list
        && get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAll(data.activeMemberUids)
        && request.auth.uid in data.activeMemberUids
        && data.activeMemberCount is number
        && data.activeMemberCount >= 1
        && data.activeMemberCount == data.activeMemberUids.size()
        && data.requiredActiveMembers is number
        && data.requiredActiveMembers >= 1
        && data.requiredActiveMembers >= get(/databases/$(database)/documents/communities/$(communityId)).data.members.size() / 2
        && data.requiredActiveMembers - 1 < get(/databases/$(database)/documents/communities/$(communityId)).data.members.size() / 2
        && data.requiredActiveMembers <= get(/databases/$(database)/documents/communities/$(communityId)).data.members.size()
        && data.requiredActiveMembers <= 500
        && data.qualified is bool
        && data.qualified == (data.activeMemberCount >= data.requiredActiveMembers)
        && data.updatedAt == request.time;
    }

    function validCommunityDailyActivityCreate(data, activityDateKey, communityId) {
      return validCommunityDailyActivity(data, activityDateKey, communityId)
        && data.activeMemberUids.size() == 1
        && data.activeMemberUids[0] == request.auth.uid
        && data.activeMemberCount == 1;
    }

    function validCommunityDailyActivityUpdate(data, activityDateKey, communityId) {
      return validCommunityDailyActivity(data, activityDateKey, communityId)
        && resource.data.dateKey == activityDateKey
        && data.activeMemberUids.hasAll(resource.data.activeMemberUids)
        && (
          (
            request.auth.uid in resource.data.activeMemberUids &&
            data.activeMemberUids.size() == resource.data.activeMemberUids.size()
          ) ||
          (
            !(request.auth.uid in resource.data.activeMemberUids) &&
            data.activeMemberUids.size() == resource.data.activeMemberUids.size() + 1
          )
        );
    }

    function communityStreakValue(data) {
      return data.communityStreak is number ? data.communityStreak : 0;
    }

    function validCommunitySelfJoin() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members',
          'memberCount',
          'updatedAt'
        ])
        && resource.data.members is list
        && request.resource.data.members is list
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= 500
        && request.resource.data.memberCount is number
        && request.resource.data.memberCount == request.resource.data.members.size()
        && request.resource.data.updatedAt == request.time;
    }

    function validCommunitySelfLeave() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && changed.hasOnly([
          'members',
          'memberCount',
          'lastMessage',
          'lastSenderUid',
          'lastSenderName',
          'updatedAt'
        ])
        && resource.data.members is list
        && request.resource.data.members is list
        && request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members)
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && request.resource.data.memberCount is number
        && request.resource.data.memberCount == request.resource.data.members.size()
        && validOptionalCommunityMessageSummaryFields(changed)
        && request.resource.data.updatedAt == request.time;
    }

    function validCommunityMessageSummaryFields(changed) {
      return changed.hasAll([
          'lastMessage',
          'lastSenderUid',
          'lastSenderName'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastSenderName is string
        && request.resource.data.lastSenderName.size() > 0
        && request.resource.data.lastSenderName.size() <= 80;
    }

    function validOptionalCommunityMessageSummaryFields(changed) {
      return !changed.hasAny([
          'lastMessage',
          'lastSenderUid',
          'lastSenderName'
        ])
        || validCommunityMessageSummaryFields(changed);
    }

    function validCommunityMessageSummaryUpdate(communityId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isCommunityParticipant(communityId)
        && changed.hasOnly([
          'lastMessage',
          'lastSenderUid',
          'lastSenderName',
          'updatedAt'
        ])
        && validCommunityMessageSummaryFields(changed)
        && request.resource.data.updatedAt == request.time;
    }

    function validCommunityActivitySummaryUpdate(communityId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let dayKey = request.resource.data.lastCommunityActivityDateKey;
      let activity = getAfter(/databases/$(database)/documents/communities/$(communityId)/dailyActivity/$(dayKey)).data;
      return isCommunityParticipant(communityId)
        && changed.hasOnly([
          'activeMemberCountToday',
          'requiredActiveMembersToday',
          'lastCommunityActivityDateKey',
          'lastCommunityActivityAt',
          'updatedAt',
          'communityStreak',
          'lastCommunityStreakDateKey'
        ])
        && dayKey is string
        && dayKey.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.lastCommunityActivityAt == request.time
        && request.resource.data.updatedAt == request.time
        && activity.dateKey == dayKey
        && activity.activeMemberCount == request.resource.data.activeMemberCountToday
        && activity.requiredActiveMembers == request.resource.data.requiredActiveMembersToday
        && (
          !changed.hasAny(['communityStreak', 'lastCommunityStreakDateKey'])
          || (
            request.resource.data.communityStreak is number
            && request.resource.data.communityStreak >= 0
            && request.resource.data.communityStreak <= communityStreakValue(resource.data) + 1
            && (
              request.resource.data.communityStreak <= communityStreakValue(resource.data)
              || activity.qualified == true
            )
            && (
              !changed.hasAny(['lastCommunityStreakDateKey'])
              || (
                request.resource.data.lastCommunityStreakDateKey == dayKey
                && activity.qualified == true
              )
            )
          )
        );
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);

      match /friends/{friendUid} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      match /routines/{routineId} {
        allow read, write: if isOwner(uid);
      }

      match /communities/{communityId} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if (isOwner(uid) && validNotification(request.resource.data, notificationId))
          || validSocialNotificationCreate(uid, notificationId);
      }
    }

    match /public_profiles/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    match /chats/{chatId} {
      allow create: if validDirectChatCreate();
      // Membership is checked against the chat doc's own fields (not via
      // get()) so list queries like `where('members', arrayContains: uid)`
      // can be proven by the rules engine; get()-based rules always fail
      // for queries with PERMISSION_DENIED.
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow update: if isChatMember(chatId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.type == resource.data.type;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if validDirectMessageCreate(chatId);
        allow update, delete: if false;
      }
    }

    match /agent_memory/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && validString(request.resource.data.name, 80)
        && (
          request.resource.data.creatorUid == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid
        );
      allow update: if isSignedIn()
        && (
          resource.data.creatorUid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          validCommunitySelfJoin() ||
          validCommunitySelfLeave() ||
          validCommunityMessageSummaryUpdate(communityId) ||
          validCommunityActivitySummaryUpdate(communityId)
        );
      allow delete: if isSignedIn()
        && (
          resource.data.creatorUid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid
        );

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /dailyActivity/{activityDateKey} {
        allow read: if isSignedIn();
        allow create: if isCommunityParticipant(communityId)
          && validCommunityDailyActivityCreate(request.resource.data, activityDateKey, communityId);
        allow update: if isCommunityParticipant(communityId)
          && validCommunityDailyActivityUpdate(request.resource.data, activityDateKey, communityId);
        allow delete: if false;
      }
    }
  }
}
