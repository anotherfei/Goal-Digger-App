rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDirectChatMember() {
      return isSignedIn()
        && request.auth.uid in resource.data.members;
    }

    function validDirectChatCreate() {
      return isSignedIn()
        && request.resource.data.type == 'direct'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function validCommunityCreate() {
      return isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members;
    }

    function isCommunityOwner() {
      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    function isExistingCommunityMember() {
      return isSignedIn()
        && request.auth.uid in resource.data.members;
    }

    function isJoiningCommunity() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members;
    }

    function isLeavingCommunity() {
      return isSignedIn()
        && request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /public_profiles/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }

    match /communities/{communityId} {
      allow read: if isSignedIn();

      // The app creates communities with ownerUid, not creatorUid.
      allow create: if validCommunityCreate();

      // Allows:
      // - owner editing community fields
      // - members joining/leaving via members/memberCount/updatedAt
      allow update: if isCommunityOwner()
        || isExistingCommunityMember()
        || isJoiningCommunity()
        || isLeavingCommunity();

      allow delete: if isCommunityOwner();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members;

        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if isDirectChatMember();

      allow create: if validDirectChatCreate();

      allow update: if isDirectChatMember()
        && request.resource.data.members == resource.data.members;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }
  }
}
