// firestore.rules
// ----------------
// Deploy with: firebase deploy --only firestore:rules
//
// Architecture:
//   users/{uid}                         ← user profile (private)
//   users/{uid}/goals/{goalId}          ← goals (private per user)
//   users/{uid}/goals/{goalId}/tasks/*  ← tasks (private per user)
//   users/{uid}/joinedCommunities/*     ← memberships (private per user)
//   communities/{groupId}               ← shared group metadata (read: all, write: auth)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validGoal() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'title', 'importance', 'category', 'deadline'])
          && data.title is string
          && data.title.size() > 0
          && data.importance is int
          && data.importance >= 1
          && data.importance <= 5;
    }

    function validTask() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'goalId', 'title', 'durationMinutes', 'load'])
          && data.title is string
          && data.durationMinutes is int
          && data.durationMinutes > 0
          && data.load in ['light', 'focus', 'stretch'];
    }

    // ── User profiles ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // ── Goals ────────────────────────────────────────────────────────────────
      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validGoal();
        allow update: if isOwner(uid) && validGoal();
        allow delete: if isOwner(uid);

        // ── Tasks (sub-collection) ──────────────────────────────────────────────
        match /tasks/{taskId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && validTask();
          allow update: if isOwner(uid) && validTask();
          allow delete: if isOwner(uid);
        }
      }

      // ── Joined communities ────────────────────────────────────────────────────
      match /joinedCommunities/{groupId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Communities (shared) ───────────────────────────────────────────────────
    match /communities/{groupId} {
      // Any authenticated user can read community listings.
      allow read: if isSignedIn();

      // Only authenticated users can create a community.
      allow create: if isSignedIn();

      // Member-count updates are allowed (toggling join increments the counter).
      allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'updatedAt']);

      // Deletion is restricted (admin-only in production — add a custom claim).
      allow delete: if false;
    }
  }
}
